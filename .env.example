# 国内官方大模型配置。默认使用 DeepSeek 官方 OpenAI 兼容接口。
# 密钥只放在本地 .env，绝不要提交到 Git。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=8192

# 百炼多模态视频拉片（与上面的文本大模型密钥分开配置）
# 创建百炼 API Key 后填写；也可覆盖为控制台提供的 Workspace 兼容端点。
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_VIDEO_MODEL=qwen3.5-omni-plus
BAILIAN_TIMEOUT_MS=300000
BAILIAN_MAX_TOKENS=8192

PORT=4173
DATABASE_PATH=./data/ai-content-director.db
